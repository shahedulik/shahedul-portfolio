{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/SHAH-CV.pdf",
      "headers": [
        { "key": "Content-Disposition", "value": "attachment; filename=\"Shahedul-Islam-Khan-CV.pdf\"" }
      ]
    }
  ]
}
